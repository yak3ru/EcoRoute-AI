# EcoRoute AI ML Environment Configuration
# Copy this file to .env before running the ML service:
# cp .env.example .env
# Then replace the placeholder values with your local credentials.
# Do NOT commit or push the .env file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoroute_ai
DB_USER=root
DB_PASSWORD=your_mysql_password
OSRM_BASE_URL=http://router.project-osrm.org
ML_SERVICE_KEY=your_ml_service_key